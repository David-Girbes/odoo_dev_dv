<odoo>
  <data>
    <!-- VISTAS DRON__________________________________________ -->

    <record model="ir.ui.view" id="dron_list">
      <field name="name">dronify list</field>
      <field name="model">dronify.dron</field>
      <field name="arch" type="xml">
        <list decoration-danger="bateria &lt; 25">
          <field name="name"/>
          <field name="capacidad_max"/>
          <field name="bateria" widget="progressbar"/>
          <field name="estado" widget="badge"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="dron_form">
      <field name="name">Formulario de Drones</field>
      <field name="model">dronify.dron</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="capacidad_max"/>
                <field name="bateria"/>
                <field name="estado"/>
                <field name="piloto_autorizado_ids" widget="many2many_tags"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <!-- Actions dron-->
    <record model="ir.actions.act_window" id="action_drones">
      <field name="name">Drones</field>
      <field name="res_model">dronify.dron</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- VISTAS CONTACTO_______________________________________ -->

    <record model="ir.actions.act_window" id="action_contacto">
      <field name="name">Contacto</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- VISTAS PAQUETE__________________________________________ -->

    <record model="ir.ui.view" id="paquete_list">
      <field name="name">paquete list</field>
      <field name="model">dronify.paquete</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="peso"/>
          <field name="cliente_id"/>
          <field name="vuelo_id"/>
          <field name="dron_relacionado"/>
        </list>
      </field>
    </record>
    <!-- Actions paquete-->
    <record model="ir.actions.act_window" id="action_paquetes">
      <field name="name">Paquetes</field>
      <field name="res_model">dronify.paquete</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- VISTAS VUELOS__________________________________________ -->

    <record model="ir.ui.view" id="vuelos_list">
      <field name="name">vuelos list</field>
      <field name="model">dronify.vuelo</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="dron_id"/>
          <field name="piloto_id"/>
          <field name="peso_total"/>
          <field name="preparado" widget="boolean_toggle"/>
          <field name="realizado" widget="boolean_toggle"/>
          <!-- <field name="consumo_estimado"/> -->
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="vuelo_form">
      <field name="name">Formulario de Vuelos</field>
      <field name="model">dronify.vuelo</field>
      <field name="arch" type="xml">
        <form>
          <header>
          </header>
          <sheet>
            <group string="Planificación">
              <field name="name"/>
              <field name="dron_id"/>
              <field name="piloto_id"/>
            </group>
            <group string="Estado y control">
              <field name="preparado"/>
              <field name="realizado"/>
            </group>
          </sheet>
          <footer>
            <field name="paquetes_ids"/>
            <field name="peso_total"/>
            <!-- <field name="consumo_estimado"> -->
          </footer>
        </form>
      </field>
    </record>


    <!-- Actions Vuelo-->
    <record model="ir.actions.act_window" id="action_vuelos">
      <field name="name">Vuelos</field>
      <field name="res_model">dronify.vuelo</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- MENÚS______________________________________________________-->
    <menuitem name="Dronify" id="dronify.menu_root"/>
    
    <menuitem name="Menú" id="menu_gestion" parent="menu_root"/>
    

    <!-- Items del menú -->
    <menuitem name="Drones" id="menuitem_drones" parent="menu_gestion"
              action="action_drones" sequence="1"/>
    <menuitem name="Contactos" id="menuitem_contactos" parent="menu_gestion"
              action="action_contacto" sequence="2"/>
    <menuitem name="Paquetes" id="menuitem_paquetes" parent="menu_gestion"
              action="action_paquetes" sequence="3"/>
    <menuitem name="Vuelos" id="menuitem_vuelos" parent="menu_gestion"
              action="action_vuelos" sequence="4"/>


  </data>
</odoo>
