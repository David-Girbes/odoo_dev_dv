<odoo>
  <data> 

    <!--  VISTAS DE PLATOS  -->
    
    <!-- Lista de platos -->
    <record model="ir.ui.view" id="plato_list">
      <field name="name">Lista de Platos</field>
      <field name="model">gestion_restaurante_david.plato_david</field>
      <field name="arch" type="xml">
        <list decoration-muted="disponible==False" decoration-success="descuento &gt; 0" decoration-warning="precio &gt; 20">
          <field name="name"/>
          <field name="codigo"/>
          <field name="categoria_id"/>
          <field name="precio"/>
          <field name="precio_con_iva"/>
          <field name="precio_final" sum="Total Ingresos"/>
          <field name="disponible"/>
          <field name="menu_id"/>
          <field name="chef_especializado"/>
        </list>
      </field>
    </record>

    <!-- Formulario de platos -->
    <record model="ir.ui.view" id="plato_form">
      <field name="name">Formulario de Platos</field>
      <field name="model">gestion_restaurante_david.plato_david</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group string="Información General">
                <field name="name"/>
                <field name="codigo"/>
                <field name="descripcion"/>
              </group>
              <group string="Precios">
                <field name="precio"/>
                <field name="precio_con_iva"/>
                <field name="descuento"/>
                <field name="precio_final"/>
                <field name="categoria_id"/>
                <field name="fecha_alta"/>
              </group>
            </group>
            <group>
              <group string="Detalles">
                <field name="tiempo_preparacion"/>
                <field name="disponible"/>
                <field name="menu_id"/>
                <field name="chef_especializado"/>
              </group>
              <group string="Ingredientes">
                <field name="ingrediente_ids" widget="many2many_tags" nolabel="1"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Acción de platos -->
    <record model="ir.actions.act_window" id="action_platos">
      <field name="name">Platos</field>
      <field name="res_model">gestion_restaurante_david.plato_david</field>
      <field name="view_mode">list,form</field>
    </record>


    <!--  VISTAS DE MENÚS  -->
    
    <!-- Lista de menús -->
    <record model="ir.ui.view" id="menu_list">
      <field name="name">Lista de Menús</field>
      <field name="model">gestion_restaurante_david.menu_david</field>
      <field name="arch" type="xml">
        <list decoration-info="activo==True" decoration-muted="vencido==True" decoration-warning="proximo_vencer==True">
          <field name="name"/>
          <field name="fecha_inicio"/>
          <field name="fecha_fin"/>
          <field name="activo"/>
          <field name="vencido" invisible="1"/>
          <field name="proximo_vencer" invisible="1"/>
          <field name="precio_total" sum="Total"/>
        </list>
      </field>
    </record>

    <!-- Formulario de menús -->
    <record model="ir.ui.view" id="menu_form">
      <field name="name">Formulario de Menús</field>
      <field name="model">gestion_restaurante_david.menu_david</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="descripcion"/>
              </group>
              <group>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="activo"/>
                <field name="precio_total"/>
                <field name="creado_por"/>
                <field name="dias_disponible"/>
                <field name="camareros_ids"/>

              </group>
            </group>
            <field name="platos">
              <list>
                <field name="name"/>
                <field name="categoria_id"/>
                <field name="precio_final"/>
                <field name="disponible"/>
              </list>            
            </field>            
          </sheet>
        </form>
      </field>
    </record>

    <!-- Acción de menús -->
    <record model="ir.actions.act_window" id="action_menus">
      <field name="name">Menús</field>
      <field name="res_model">gestion_restaurante_david.menu_david</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- VISTAS DE INGREDIENTES -->
    
    <!-- Lista de ingredientes -->
    <record model="ir.ui.view" id="ingredientes_list">
      <field name="name">Lista de Ingredientes</field>
      <field name="model">gestion_restaurante_david.ingredientes_david</field>
      <field name="arch" type="xml">
        <list decoration-danger="es_alergeno==True">
          <field name="name"/>
          <field name="es_alergeno"/>
          <field name="descripcion"/>
        </list>
      </field>
    </record>

    <!-- Formulario de ingredientes -->
    <record model="ir.ui.view" id="ingredientes_form">
      <field name="name">Formulario de Ingredientes</field>
      <field name="model">gestion_restaurante_david.ingredientes_david</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Acción de ingredientes -->
    <record model="ir.actions.act_window" id="action_ingredientes">
      <field name="name">Ingredientes</field>
      <field name="res_model">gestion_restaurante_david.ingredientes_david</field>
      <field name="view_mode">list,form</field>
    </record>

    <!--  VISTAS DE CATEGORIAS  -->
    
    <!-- Lista de categorias -->
    <record model="ir.ui.view" id="categorias_list">
      <field name="name">Lista de Categorias</field>
      <field name="model">gestion_restaurante_david.categorias_david</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="descripcion"/>
        </list>
      </field>
    </record>

    <!-- Formulario de categorias -->
    <record model="ir.ui.view" id="categorias_form">
      <field name="name">Formulario de categorias</field>
      <field name="model">gestion_restaurante_david.categorias_david</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="descripcion"/>
              </group>
            </group>
            <group string="Platos">
              <field name="platos_ids">
                <list>
                  <field name="name"/>
                  <field name="categoria_id"/>
                  <field name="precio_final"/>
                </list>
              </field>
            </group>
            <group string="Chefs">
              <field name="chef_ids">
                <list>
                  <field name="name"/>
                  <field name="especialidad_id"/>
                </list>
              </field>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Acción de categorias -->
    <record model="ir.actions.act_window" id="action_categorias">
      <field name="name">Categorias</field>
      <field name="res_model">gestion_restaurante_david.categorias_david</field>
      <field name="view_mode">list,form</field>
    </record>


    <!--  VISTAS DE CHEFS  -->
    
    <!-- Lista de chefs -->
    <record model="ir.ui.view" id="chef_list">
      <field name="name">Lista de Chefs</field>
      <field name="model">gestion_restaurante_david.chef_david</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="especialidad_id"/>
          <field name="platos_asignados"/>
        </list>
      </field>
    </record>

    <!-- Formulario de chefs -->
    <record model="ir.ui.view" id="chef_form">
      <field name="name">Formulario de Chefs</field>
      <field name="model">gestion_restaurante_david.chef_david</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="especialidad_id"/>
                <field name="platos_asignados"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Acción de chefs -->
    <record model="ir.actions.act_window" id="action_chefs">
      <field name="name">Chefs</field>
      <field name="res_model">gestion_restaurante_david.chef_david</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- VISTA DE CAMAREROS -->


    <record model="ir.ui.view" id="gestion_restaurante_david.view_partner_form_inherit">
      <field name="name">CAMAREROS</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">

       <xpath expr="//field[@name='vat']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath> 

       <xpath expr="//page[@name='contact_addresses']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <xpath expr="//field[@name='function']" position="after">
        <field name="seccion"/>
      </xpath>

        <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="after">
            <page name="devs" string="Datos Camarero" invisible="not es_camarero">
                <group>                   
                    <field name="menus_especialidad" widget="many2many_tags"/>
                    <field name="es_camarero" invisible="1" />
                    <field name="turno"/>
                </group>
            </page>
        </xpath>
      </field>
    </record>

    <record model="ir.actions.act_window" id="action_camareros">
      <field name="name">Camareros</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('es_camarero', '=', True)]</field>
      <field name="context">{'default_es_camarero': True}</field>
    </record>

    <record model="ir.actions.act_window.view" id="action_view_camareros_list">
      <field name="sequence" eval="1"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="action_camareros"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_view_camareros_form">
      <field name="sequence" eval="2"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="gestion_restaurante_david.view_partner_form_inherit"/>
      <field name="act_window_id" ref="action_camareros"/>
    </record>

    <!--  MENÚ PRINCIPAL -->
    
    <!-- Menú raíz -->
    <menuitem name="Restaurante" id="menu_root"/>

    <!-- Submenú de gestión -->
    <menuitem name="Menú" id="menu_gestion" parent="menu_root"/>

    <!-- Items del menú -->
    <menuitem name="Menús" id="menuitem_menus" parent="menu_gestion"
              action="action_menus" sequence="1"/>
    <menuitem name="Platos" id="menuitem_platos" parent="menu_gestion"
              action="action_platos" sequence="2"/>
    <menuitem name="Ingredientes" id="menuitem_ingredientes" parent="menu_gestion"
              action="action_ingredientes" sequence="3"/>
    <menuitem name="Categorias" id="menuitem_categorias" parent="menu_gestion"
              action="action_categorias" sequence="4"/>
    <menuitem name="Chefs" id="menuitem_chefs" parent="menu_gestion"
              action="action_chefs" sequence="5"/>
    <menuitem name="Camareros" id="menuitem_camareros" parent="menu_gestion"
              action="action_camareros" sequence="6"/>

  </data>
</odoo>